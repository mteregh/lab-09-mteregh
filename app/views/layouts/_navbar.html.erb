<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <%= link_to "VetClinic", root_path, class: "navbar-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      <% if user_signed_in? %>
        <ul class="navbar-nav me-auto">
          <% if current_user.admin? || current_user.vet? %>
            <li class="nav-item">
              <%= link_to "Owners", owners_path, class: "nav-link" %>
            </li>
          <% elsif current_user.owner? && current_user.owner.present? %>
            <li class="nav-item">
              <%= link_to "My account", owner_path(current_user.owner), class: "nav-link" %>
            </li>
          <% end %>

          <li class="nav-item">
            <%= link_to "Pets", pets_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Vets", vets_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Appointments", appointments_path, class: "nav-link" %>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2">
          <span class="navbar-text text-white">
            <%= current_user.full_name %>
          </span>

          <%= button_to "Sign out",
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-outline-danger btn-sm" %>
        </div>

      <% else %>
        <div class="d-flex gap-2 ms-auto">
          <%= link_to "Sign in",
                new_user_session_path,
                class: "btn btn-outline-light" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>