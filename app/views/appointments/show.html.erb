<h1 class="mb-4">Appointment Details</h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Date:</strong> <%= @appointment.date.strftime("%B %d, %Y %I:%M %p") %></p>
    <p><strong>Reason:</strong> <%= @appointment.reason %></p>
    <p><strong>Status:</strong> <%= @appointment.status.humanize %></p>
    <p><strong>Pet:</strong> <%= link_to @appointment.pet.name, pet_path(@appointment.pet) %></p>
    <p><strong>Vet:</strong> <%= link_to @appointment.vet.full_name, vet_path(@appointment.vet) %></p>
  </div>
</div>

<% if policy(@appointment).edit? %>
  <%= link_to "Edit", edit_appointment_path(@appointment), class: "btn btn-warning" %>
<% end %>

<% if policy(@appointment).destroy? %>
  <%= button_to "Delete", appointment_path(@appointment),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
        class: "btn btn-danger d-inline" %>
<% end %>

<%= link_to "Back to appointments", appointments_path, class: "btn btn-secondary" %>

<hr>

<h2>Treatments</h2>

<% if policy(Treatment).new? %>
  <%= link_to "New Treatment",
        new_appointment_treatment_path(@appointment),
        class: "btn btn-primary mb-3" %>
<% end %>

<% if @appointment.treatments.any? %>
  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Medication</th>
        <th>Dosage</th>
        <th>Administered at</th>
        <th>Clinical notes</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @appointment.treatments.each do |treatment| %>
        <tr>
          <td><%= treatment.name %></td>
          <td><%= treatment.medication %></td>
          <td><%= treatment.dosage %></td>
          <td><%= treatment.administered_at&.strftime("%B %d, %Y %I:%M %p") %></td>
          <td><%= treatment.clinical_notes %></td>

          <td>
            <% if policy(treatment).edit? %>
              <%= link_to "Edit",
                    edit_appointment_treatment_path(@appointment, treatment),
                    class: "btn btn-warning btn-sm me-1" %>
            <% end %>

            <% if policy(treatment).destroy? %>
              <%= button_to "Delete",
                    appointment_treatment_path(@appointment, treatment),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure?" },
                    class: "btn btn-danger btn-sm d-inline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No treatments recorded for this appointment.</p>
<% end %>