<h1 class="mb-4">Appointments</h1>

<% if policy(Appointment).new? %>
  <%= link_to "New Appointment", new_appointment_path, class: "btn btn-primary mb-3" %>
<% end %>

<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th>Date</th>
      <th>Pet name</th>
      <th>Vet name</th>
      <th>Reason</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @appointments.each do |appointment| %>
      <tr>
        <td><%= link_to appointment.date.strftime("%B %d, %Y %I:%M %p"), appointment_path(appointment) %></td>
        <td><%= link_to appointment.pet.name, pet_path(appointment.pet) %></td>
        <td><%= link_to appointment.vet.full_name, vet_path(appointment.vet) %></td>
        <td><%= appointment.reason %></td>
        <td><%= appointment.status.humanize %></td>

        <td>
          <% if policy(appointment).edit? %>
            <%= link_to "Edit", edit_appointment_path(appointment), class: "btn btn-warning btn-sm me-1" %>
          <% end %>

          <% if policy(appointment).destroy? %>
            <%= button_to "Delete", appointment_path(appointment),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-danger btn-sm d-inline" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>