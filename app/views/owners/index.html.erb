<h1 class="mb-4">Owners</h1>

<% if policy(Owner).new? %>
  <%= link_to "New Owner", new_owner_path, class: "btn btn-primary mb-3" %>
<% end %>

<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th>Full name</th>
      <th>Email</th>
      <th>Phone</th>
      <th>Number of pets</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @owners.each do |owner| %>
      <tr>
        <td><%= link_to owner.full_name, owner_path(owner) %></td>
        <td><%= owner.email %></td>
        <td><%= owner.phone %></td>
        <td><%= owner.pets.count %></td>

        <td>
          <% if policy(owner).edit? %>
            <%= link_to "Edit", edit_owner_path(owner), class: "btn btn-warning btn-sm me-1" %>
          <% end %>

          <% if policy(owner).destroy? %>
            <%= button_to "Delete", owner_path(owner),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-danger btn-sm d-inline" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>