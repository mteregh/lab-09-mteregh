<h1 class="mb-4">Pets</h1>

<% if policy(Pet).new? %>
  <%= link_to "New Pet", new_pet_path, class: "btn btn-primary mb-3" %>
<% end %>

<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th>Photo</th>
      <th>Name</th>
      <th>Species</th>
      <th>Breed</th>
      <th>Owner name</th>
      <th>Date of birth</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td>
          <% if pet.photo.attached? %>
            <%= image_tag pet.photo.variant(resize_to_fill: [60, 60]), class: "rounded" %>
          <% else %>
            <span class="text-muted">No photo</span>
          <% end %>
        </td>

        <td><%= link_to pet.name, pet_path(pet) %></td>
        <td><%= pet.species %></td>
        <td><%= pet.breed %></td>
        <td><%= link_to pet.owner.full_name, owner_path(pet.owner) %></td>
        <td><%= pet.date_of_birth.strftime("%B %d, %Y") %></td>

        <td>
          <% if policy(pet).edit? %>
            <%= link_to "Edit", edit_pet_path(pet), class: "btn btn-warning btn-sm me-1" %>
          <% end %>

          <% if policy(pet).destroy? %>
            <%= button_to "Delete", pet_path(pet),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-danger btn-sm d-inline" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>