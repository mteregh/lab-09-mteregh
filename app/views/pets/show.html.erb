<h2>Upcoming Appointments</h2>

<div class="mb-4">
  <% if @pet.photo.attached? %>
    <%= image_tag @pet.photo, class: "img-fluid rounded", width: 300 %>
  <% else %>
    <div class="border rounded p-4 text-muted">
      No photo available
    </div>
  <% end %>
</div>

<ul class="list-group">
  <% @pet.appointments.upcoming.each do |appointment| %>
    <li class="list-group-item">
      <%= link_to appointment.date.strftime("%B %d, %Y %I:%M %p"), appointment_path(appointment) %>
      - <%= appointment.reason %>
    </li>
  <% end %>
</ul>

<h2 class="mt-4">Past Appointments</h2>

<ul class="list-group">
  <% @pet.appointments.past.each do |appointment| %>
    <li class="list-group-item">
      <%= link_to appointment.date.strftime("%B %d, %Y %I:%M %p"), appointment_path(appointment) %>
      - <%= appointment.reason %>
    </li>
  <% end %>
</ul>

<hr>

<% if policy(@pet).edit? %>
  <%= link_to "Edit", edit_pet_path(@pet), class: "btn btn-warning" %>
<% end %>

<% if policy(@pet).destroy? %>
  <%= button_to "Delete", pet_path(@pet),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
        class: "btn btn-danger" %>
<% end %>

<%= link_to "Back to pets", pets_path, class: "btn btn-secondary" %>