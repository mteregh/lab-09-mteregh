<h2>Upcoming Appointments</h2>

<ul class="list-group">
  <% @vet.appointments.upcoming.each do |appointment| %>
    <li class="list-group-item">
      <%= link_to appointment.date.strftime("%B %d, %Y %I:%M %p"), appointment_path(appointment) %>
      - <%= appointment.pet.name %>
    </li>
  <% end %>
</ul>

<h2 class="mt-4">Past Appointments</h2>

<ul class="list-group">
  <% @vet.appointments.past.each do |appointment| %>
    <li class="list-group-item">
      <%= link_to appointment.date.strftime("%B %d, %Y %I:%M %p"), appointment_path(appointment) %>
      - <%= appointment.pet.name %>
    </li>
  <% end %>
</ul>

<hr>

<% if policy(@vet).edit? %>
  <%= link_to "Edit", edit_vet_path(@vet), class: "btn btn-warning" %>
<% end %>

<% if policy(@vet).destroy? %>
  <%= button_to "Delete", vet_path(@vet),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
        class: "btn btn-danger" %>
<% end %>

<%= link_to "Back to vets", vets_path, class: "btn btn-secondary" %>