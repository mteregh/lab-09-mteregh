<h1 class="mb-4">Vets</h1>

<% if policy(Vet).new? %>
  <%= link_to "New Vet", new_vet_path, class: "btn btn-primary mb-3" %>
<% end %>

<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th>Full name</th>
      <th>Email</th>
      <th>Specialization</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @vets.each do |vet| %>
      <tr>
        <td><%= link_to vet.full_name, vet_path(vet) %></td>
        <td><%= vet.email %></td>
        <td><%= vet.specialization %></td>

        <td>
          <% if policy(vet).edit? %>
            <%= link_to "Edit", edit_vet_path(vet), class: "btn btn-warning btn-sm me-1" %>
          <% end %>

          <% if policy(vet).destroy? %>
            <%= button_to "Delete", vet_path(vet),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-danger btn-sm d-inline" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>